# Dependencies (Vercel installs from lockfile)
node_modules
.pnpm-store

# Build output (Vercel builds remotely)
.next

# LoRA model files (too large for Vercel, live on RunPod volume)
loras

# IDE / local tooling
.claude
.qoder

# Temp & scratch files at project root
_tmp_*
_tmp*

# Large model files
*.safetensors

# Infra / Docker (not needed at runtime)
# NOTE: anchor with leading '/' — unanchored 'runpod' also matched
# src/app/api/runpod & src/app/api/v2/runpod, deleting the
# /api/runpod/status route from production builds (404 -> studio
# polling never reached the server and mis-reported queue timeout).
/infra
/runpod
Dockerfile
Dockerfile.dev
docker-compose.yml
