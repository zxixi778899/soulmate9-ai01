import { describe, it, expect, beforeEach, vi } from 'vitest';
import { detectIntent, getTaskType, analyzeAndRoute, getHealthStatus } from '../router-engine';
import { type MembershipTier } from '../ai-modules';

describe('Router Engine - Unified Routing System', () => {
  describe('detectIntent', () => {
    it('detects image generation intents', () => {
      expect(detectIntent('send me a selfie')).toBe('image_generation');
      expect(detectIntent('show me a picture of you')).toBe('image_generation');
      expect(detectIntent('draw yourself')).toBe('image_generation');
      expect(detectIntent('发张自拍')).toBe('image_generation');
    });

    it('detects complex reasoning', () => {
      expect(detectIntent('why is the sky blue?')).toBe('complex_reasoning');
      expect(detectIntent('explain quantum mechanics')).toBe('complex_reasoning');
      expect(detectIntent('solve x + y = z')).toBe('complex_reasoning');
    });

    it('detects emotion analysis requests', () => {
      expect(detectIntent('I feel so happy today')).toBe('emotion_detection');
      expect(detectIntent('what is my mood?')).toBe('emotion_detection');
    });

    it('detects metadata tasks', () => {
      expect(detectIntent('add tags to profile')).toBe('metadata_generation');
      expect(detectIntent('write a bio')).toBe('metadata_generation');
    });

    it('defaults to chat for casual messages', () => {
      expect(detectIntent('hi')).toBe('chat');
      expect(detectIntent('how are you?')).toBe('chat');
      expect(detectIntent("let's talk")).toBe('chat');
    });
  });

  describe('getTaskType with context', () => {
    it('refines chat → image on affirmative follow-up', () => {
      const result = getTaskType('yes please', {
        recentMessages: ['Can I see a selfie?'],
      });
      expect(result).toBe('image_generation');
    });

    it('keeps chat when unrelated context', () => {
      const result = getTaskType('yes please', {
        recentMessages: ['How are you?'],
      });
      expect(result).toBe('chat');
    });
  });

  describe('analyzeAndRoute', () => {
    it('routes free tier to economy models', () => {
      const decision = analyzeAndRoute('hello', { userTier: 'free' as MembershipTier });
      
      expect(decision.taskType).toBe('chat');
      expect(['doubao', 'coze']).toContain(decision.primaryModel.provider);
      expect(decision.confidence).toBeGreaterThan(0.9);
    });

    it('routes pro tier to premium models', () => {
      const decision = analyzeAndRoute('explain deep learning', { userTier: 'pro' as MembershipTier });
      
      expect(decision.taskType).toBe('complex_reasoning');
      expect(decision.primaryModel.provider).toBe('deepseek');
      expect(decision.primaryModel.thinkingMode).toBe(true);
    });

    it('includes fallback chain', () => {
      const decision = analyzeAndRoute('chat test', { userTier: 'free' as MembershipTier });
      
      expect(decision.fallbackChain).toBeInstanceOf(Array);
      expect(decision.fallbackChain.length).toBeGreaterThan(0);
      expect(decision.estimatedCost).toBeGreaterThan(0);
    });

    it('handles NSFW preference correctly', () => {
      const decision = analyzeAndRoute('chat', { 
        userTier: 'pro' as MembershipTier,
        preferNsfw: true,
      });
      
      // Should exclude NSFW-incompatible providers
      expect(decision.primaryModel.provider).not.toBe('coze');
    });

    it('estimates cost and latency accurately', () => {
      const decision = analyzeAndRoute('hello world', { userTier: 'free' as MembershipTier });
      
      expect(decision.estimatedCost).toBeGreaterThanOrEqual(0);
      expect(decision.estimatedLatencyMs).toBeGreaterThan(0);
    });
  });

  describe('Health Monitor', () => {
    it('returns initial health status for all providers', () => {
      const status = getHealthStatus();
      expect(status).toHaveProperty('coze');
      expect(status).toHaveProperty('doubao');
      expect(status).toHaveProperty('claude');
      expect(status).toHaveProperty('deepseek');
    });

    it('tracks provider failures', () => {
      // Simulate failure tracking (mock would handle this)
      expect(getHealthStatus().coze?.healthy).toBe(true);
    });
  });

  describe('Tier-based routing decisions', () => {
    const tiers: MembershipTier[] = ['free', 'basic', 'pro', 'premium', 'unlimited'];

    tiers.forEach(tier => {
      it(`selects appropriate quality for ${tier} tier`, () => {
        const decision = analyzeAndRoute('chat', { userTier: tier });
        
        if (tier === 'free') {
          expect(decision.primaryModel.quality).toBe('economy');
        } else if (tier === 'pro') {
          expect(['standard', 'premium']).toContain(decision.primaryModel.quality);
        } else {
          expect(decision.primaryModel.quality).toBe('premium');
        }
      });
    });
  });

  describe('Specialized task routing', () => {
    it('routes image generation to specialized pipeline', () => {
      const decision = analyzeAndRoute('generate an image', { userTier: 'pro' as MembershipTier });
      expect(decision.taskType).toBe('image_generation');
    });

    it('routes emotion detection to fast models', () => {
      const decision = analyzeAndRoute('I feel sad', { userTier: 'free' as MembershipTier });
      expect(decision.taskType).toBe('emotion_detection');
      // Should prioritize speed over quality
    });

    it('routes complex reasoning with extended tokens', () => {
      const decision = analyzeAndRoute('explain quantum entanglement in detail', { userTier: 'pro' as MembershipTier });
      expect(decision.taskType).toBe('complex_reasoning');
      expect(decision.estimatedLatencyMs).toBeGreaterThanOrEqual(2000);
    });
  });
});
