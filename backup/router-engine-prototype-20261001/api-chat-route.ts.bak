/**
 * Chat API - Unified routing for all chat requests
 * 
 * POST /api/chat
 * Body: { message, context?, options? }
 * Response: { reply, routeDecision, metrics? }
 * 
 * Features:
 * - Intelligent intent-based routing to optimal model
 * - Automatic fallback chain on failure
 * - Health-aware provider selection
 * - Cost optimization by tier
 */

import { NextRequest, NextResponse } from 'next/server';
import { getAuthUser } from '@/lib/supabase-server';
import { analyzeAndRoute, type RouterDecision, ProviderId } from '@/lib/router-engine';
import { logger } from '@/lib/logger';
import { captureException } from '@/lib/sentry';

