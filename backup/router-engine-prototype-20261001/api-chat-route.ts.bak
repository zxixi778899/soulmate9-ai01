  messages: Array<{ role: 'user' | 'assistant' | 'system'; content: string }>;
  model: string;
  maxTokens?: number;
  temperature?: number;
  stream?: boolean;
}

async function callCoze(data: ChatRequest): Promise<string> {
  // Implement Coze API call
  throw new Error('Coze adapter not implemented');
}

