/**
 * Router Engine - Unified Multimodal LLM Routing Center
 * 
 * Centralized routing for all AI requests (chat, image, reasoning)
 * with health monitoring, automatic fallback, and tier-based model selection.
 * 
 * Architecture:
 * 1. Intent Classification - Analyze user message to determine task type
 * 2. Tier Router - Select base model by membership level (free/pro/unlimited)
 * 3. Health Monitor - Real-time provider health + circuit breaker
 * 4. Provider Selection - Choose optimal endpoint from available providers
 * 5. Fallback Chain - Automatic retry on failure with degraded mode
 * 
 * Providers Supported:
 * - Coze (primary chat)
 * - Doubao (cost-effective tiered models)
 * - Claude (fallback quality)
 * - DeepSeek (complex reasoning with thinking mode)
 * - RunPod FLUX/SDXL (image generation)
 * - Minimax/Other (regional alternatives)
 */

import { z } from 'zod';

// ──────────────────────────────────────────────────────────────
// Types & Config
// ──────────────────────────────────────────────────────────────

export type TaskType = 
  | 'chat'
  | 'emotion_detection'
  | 'metadata_generation'
  | 'prompt_optimization'
  | 'image_generation'
  | 'image_edit'
  | 'complex_reasoning'
  | 'language_translation'
  | 'summarization';

export type MembershipTier = 'free' | 'basic' | 'pro' | 'premium' | 'unlimited';

export type ProviderId = 
  | 'coze'
  | 'doubao'
  | 'claude'
  | 'deepseek'
  | 'runpod_flux'
  | 'runpod_sdxl_pony'
  | 'runpod_sdxl_illustrious'
  | 'minimax'
  | 'local_llama';

export type ModelQuality = 'economy' | 'standard' | 'premium';

export interface ModelConfig {
  id: string;
  name: string;
  provider: ProviderId;
  quality: ModelQuality;
  maxTokens: number;
  costPerK: number; // per 1k tokens
  speed: 'fast' | 'medium' | 'slow';
  nsfwCapable: boolean;
  thinkingMode: boolean;
  active: boolean;
}

export interface HealthStatus {
  healthy: boolean;
  lastChecked: number;
  failureCount: number;
  avgLatencyMs: number;
  error?: string;
}

export interface RouterContext {
  tier: MembershipTier;
  message?: string;
  recentMessages?: string[];
  userId?: string;
  preferNsfw?: boolean;
  locale?: string;
  complexityHint?: number; // 0-1, higher = more complex
}

export interface RouterDecision {
  taskId: string;
  taskType: TaskType;
  primaryModel: ModelConfig;
  fallbackChain: ModelConfig[];
  healthStatus: Record<ProviderId, HealthStatus>;
  estimatedCost: number;
  estimatedLatencyMs: number;
  routeReason: string;
  confidence: number; // 0-1, how confident in this routing
  metadata?: Record<string, any>;
}

