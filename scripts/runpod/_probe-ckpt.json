{
  "workflow": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "PROBE_MISSING.safetensors" }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "probe", "clip": ["1", 1] }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "bad", "clip": ["1", 1] }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": { "width": 512, "height": 512, "batch_size": 1 }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["4", 0],
        "seed": 1,
        "steps": 1,
        "cfg": 1,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1
      }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["5", 0], "vae": ["1", 2] }
    },
    "7": {
      "class_type": "SaveImage",
      "inputs": { "images": ["6", 0], "filename_prefix": "probe" }
    }
  }
}
