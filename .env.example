# =============================
# SoulMate AI — Environment Variables
# =============================
# Copy to .env.local for local dev, set in Railway/Vercel project settings for prod.
# Required unless marked OPTIONAL. Keep this file in sync with `src/` —
# run: grep -rohE "process\.env\.[A-Z_0-9]+" src | sort -u
# whenever you add a new process.env.* reference, and add it here.

# ── Production compliance gates ──
# CONTENT_MODE: sfw or adult. Never label an adult deployment as sfw.
CONTENT_MODE=
# PAYMENT_PROVIDER: disabled, stripe, or approved_adult_merchant.
PAYMENT_PROVIDER=disabled
# Written approval / merchant account references. Do not place secrets here.
PAYMENT_PROVIDER_APPROVAL_REF=
HOSTING_CONTENT_APPROVAL_REF=
# Adult production requires a real age-assurance provider, not only the UI modal.
AGE_VERIFICATION_PROVIDER=
# Adult launch also requires a reviewed text/image/video safety pipeline.
CONTENT_SAFETY_PROVIDER=
CONTENT_SAFETY_APPROVAL_REF=

# Legal identity shown in Terms/Privacy. Review the legal pages with qualified counsel.
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=
PRIVACY_CONTACT_EMAIL=
LEGAL_JURISDICTION=

# ── Supabase Auth (public project — used by browser + server to verify JWT) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase Data (second "Coze" project — service-role access for app data) ──
# NOTE: COZE_SUPABASE_ANON_KEY (no NEXT_PUBLIC_ prefix) is REQUIRED server-side
# by src/storage/database/supabase-client.ts — it is NOT the same variable as
# NEXT_PUBLIC_COZE_SUPABASE_ANON_KEY (browser-exposed). Both must be set.
NEXT_PUBLIC_COZE_SUPABASE_URL=
NEXT_PUBLIC_COZE_SUPABASE_ANON_KEY=
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
COZE_SUPABASE_SERVICE_ROLE_KEY=
COZE_SUPABASE_DB_URL=

# ── Auth admin bootstrap (works in production when set) ──
# Comma-separated emails that can open /admin even if profiles.role is still "user".
# Example: ALLOWED_ADMIN_EMAILS=you@gmail.com
# Prefer also setting profiles.role='admin' in Supabase for long-term RBAC.
ALLOWED_ADMIN_EMAILS=

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs — used by pricing page + webhook to resolve tier from Stripe price.
STRIPE_PRO_PRICE_ID=
STRIPE_UNLIMITED_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_UNLIMITED_PRICE_ID=
# Legacy aliases still read by some code paths — keep equal to the above until fully migrated.
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_UNLIMITED=

# ── Stripe Price IDs — DEFER TO LAUNCH（用户约定：正式上线前再填）──
# 未配置时代码会用 price_data 动态定价，开发/测试可留空。
# 上线提醒：见 docs/LAUNCH_STRIPE_REMINDER.md
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_UNLIMITED_YEARLY_PRICE_ID=
STRIPE_TOKENS_100_PRICE_ID=
STRIPE_TOKENS_500_PRICE_ID=
STRIPE_TOKENS_1000_PRICE_ID=
# Optional aliases (if you also expose yearly prices to the client):
# NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=
# NEXT_PUBLIC_STRIPE_UNLIMITED_YEARLY_PRICE_ID=

# ── RunPod FLUX image generation ──
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_ENDPOINT_ID_FLUX=
RUNPOD_ENDPOINT_ID_SDXL=
# Dedicated SDXL endpoint. Required before Pony/Illustrious routing is enabled;
# LoRA inventory alone does not prove that the checkpoint is mounted.
RUNPOD_CHECKPOINT_FLUX=flux1-dev-fp8.safetensors
RUNPOD_CHECKPOINT_PONY=ponyRealism_V22.safetensors
RUNPOD_CHECKPOINT_ILLUSTRIOUS=waiMatureIllustrious_v20.safetensors
# Gate for Pony/Illustrious specialist routing. Set 'true' ONLY after the SDXL
# worker volume has been verified to carry the checkpoints below.
RUNPOD_SDXL_MODELS_READY=false
# Comma-separated checkpoint filenames actually mounted on the SDXL worker volume.
# When declared, routing/preflight cross-check requested checkpoints against this
# list and fall back to FLUX on mismatch (prevents value_not_in_list failures).
RUNPOD_SDXL_CHECKPOINTS=
# Separate inventories prevent FLUX LoRAs from being sent to Pony/Illustrious.
RUNPOD_INSTALLED_LORAS_FLUX=
# Optional shared CD2 inventory; family-specific inventories below take precedence.
RUNPOD_INSTALLED_LORAS_SDXL=
RUNPOD_INSTALLED_LORAS_PONY=
RUNPOD_INSTALLED_LORAS_ILLUSTRIOUS=
# Comma-separated, ordered compatible LoRA filenames on the matching endpoint volume.
RUNPOD_PONY_FEMALE_LORAS=
RUNPOD_PONY_MALE_LORAS=
RUNPOD_PONY_TRANSGENDER_LORAS=
RUNPOD_PONY_NSFW_LORAS=
RUNPOD_ILLUSTRIOUS_2D_LORAS=
RUNPOD_ILLUSTRIOUS_NSFW_LORAS=
# Alias accepted for RUNPOD_API_KEY in some clients — set one or the other.
RUNPOD_COMFYUI_API_KEY=
SUPABASE_STORAGE_BUCKET=portraits
# Private bucket for chats, user uploads, generated portraits, and voice notes.
SUPABASE_PRIVATE_STORAGE_BUCKET=user-media

# ── RunPod vLLM (dedicated NSFW-capable text model, OPTIONAL) ──
# When unset, NSFW chat falls back further down the chain — see llm-service.ts.
RUNPOD_VLLM_URL=
RUNPOD_VLLM_API_KEY=
RUNPOD_VLLM_MODEL=
RUNPOD_PRO_CHAT_URL=https://api.runpod.ai/v2/m4va2u0uqugd9v/openai/v1
RUNPOD_PRO_CHAT_MODEL=Qwen3-8B-Pro-NSFW
RUNPOD_UNLIMITED_CHAT_URL=https://api.runpod.ai/v2/pe83m495wybb9d/openai/v1
RUNPOD_UNLIMITED_CHAT_MODEL=Qwen3-30B-Unlimited

# ── LLM primary provider: Coze (Doubao) ──
# Auth: workload-identity credentials exchanged for a short-lived JWT.
# This is the ONLY pair actually read by src/lib/coze-auth.ts — the old
# COZE_API_KEY variable name is NOT used anywhere in the codebase, do not rely on it.
COZE_WORKLOAD_IDENTITY_API_KEY=
COZE_WORKLOAD_IDENTITY_CLIENT_SECRET=
# OPTIONAL overrides — defaults to https://api.coze.cn / https://integration.coze.cn
COZE_AUTH_BASE_URL=
COZE_INTEGRATION_BASE_URL=
COZE_INTEGRATION_MODEL_BASE_URL=
# OPTIONAL — Coze project environment tag, if used by your Coze workspace setup.
COZE_PROJECT_ENV=

# ──── DashScope / Alibaba Bailian (SFW fallback LLM, demoted in v4) ────
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# ──── MiniMax official API (v4 SFW primary for paid tiers, MiniMax-M2) ────
MINIMAX_API_KEY=

# ── LLM fallback chain (in order): Anthropic Claude -> Together AI -> OpenRouter -> local Llama ──
ANTHROPIC_API_KEY=
CLAUDE_FALLBACK_MODEL=claude-3-5-haiku-20241022
TOGETHER_API_KEY=
TOGETHER_MODEL=
TOGETHER_FAST_MODEL=
# OpenRouter (NSFW fallback / alternative routing)
OPENROUTER_API_KEY=
LOCAL_LLAMA_BASE_URL=
LOCAL_LLAMA_MODEL=

# ── Object storage (Coze-managed bucket, used alongside/instead of S3) ──
# ── Image storage: Supabase Storage (NOT Coze) ──
# Coze LLM/S3 proxy is deprecated. Uploads use Supabase service role + Storage.
# SUPABASE_STORAGE_BUCKET=portraits
# (URL / service role: use COZE_SUPABASE_* or NEXT_PUBLIC_SUPABASE_* / SUPABASE_SERVICE_ROLE_KEY)

# Deprecated Coze S3 proxy (ignored by storage.ts):
# COZE_BUCKET_ENDPOINT_URL=
# COZE_BUCKET_NAME=

# ── Crypto payment ──
CRYPTO_WALLET_BTC=
CRYPTO_WALLET_ETH=
CRYPTO_WALLET_USDT=
# See src/lib/crypto-config.ts for full NOWPayments config (OPTIONAL — enables
# automated on-chain verification instead of manual admin confirmation).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAY_CURRENCY=usdttrc20

# Token package prices in cents (e.g., 599 = $5.99)
# Used by /api/v2/shop/tokens for NOWPayments payments
CRYPTO_TOKENS_500_PRICE=599
CRYPTO_TOKENS_1000_PRICE=999
CRYPTO_TOKENS_2500_PRICE=2299
CRYPTO_TOKENS_5000_PRICE=3999
CRYPTO_TOKENS_10000_PRICE=6999

# ── Rate limit (Upstash Redis) ──
# Required for production rate limiting; without these, falls back to in-memory
# (single-instance only — Vercel/Railway serverless will not enforce global limits).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email (Resend) — OPTIONAL, falls back to Supabase default SMTP ──
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_ALERT_EMAIL=

# ── Web Push notifications — OPTIONAL ──
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Cron job auth ──
# Shared secret required by all /api/cron/* routes (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# ── Analytics — OPTIONAL ──
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_API_KEY=
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=
POSTHOG_FLUSH_INTERVAL=

# ── Sentry error monitoring — OPTIONAL ──
# Without these, src/lib/sentry.ts becomes no-op and logger.error() only
# emits JSON logs to stdout.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# ── App URLs / build metadata ──
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_COMMIT_SHA=

# ── Debug routes — DANGER ──
# Set to "true" to enable /api/admin/db-debug, /api/admin/key-debug,
# /api/admin/refresh-portraits, /api/admin/upload-scenes. These are
# additionally protected by requireAdmin('superadmin') in code.
ENABLE_DEBUG_ROUTES=

# ── Logging ──
LOG_LEVEL=debug

# AI Model Gateway v2 paid-user rollout (0-100)
AI_GATEWAY_V2_ROLLOUT_PERCENT=10
RUNPOD_PRO_CHAT_URL=
RUNPOD_UNLIMITED_CHAT_URL=
BFL_API_KEY=

# ─── New AI Services (Phase 2) ─────────────────────────────
# TTS Voice Synthesis (RunPod Fish-Speech) — on-demand endpoint
RUNPOD_TTS_ENDPOINT_ID=
# RUNPOD_TTS_API_KEY= (falls back to RUNPOD_API_KEY if unset)


# Video Generation (RunPod Wan 2.1) — Phase 2, NOT YET CREATED
# RUNPOD_WAN_VIDEO_ENDPOINT=
# WAN 2.2 is the production image-to-video route. SVD is legacy-only.
VIDEO_DEFAULT_MODEL=wan22

# STT Speech-to-Text (RunPod Whisper) — future voice call support
# RUNPOD_STT_ENDPOINT_ID=

# ─── Additional AI provider keys (OPTIONAL) ────────────────
# ElevenLabs TTS (alternative to Fish-Speech)
ELEVENLABS_API_KEY=
# Kling AI video generation
KLING_API_KEY=
# Runway ML video generation
RUNWAY_API_KEY=
# FAL.ai serverless inference
FAL_KEY=
# CivitAI model downloads
CIVITAI_API_KEY=

# ─── Meta (Facebook) Ads — AB 站投流归因 + CAPI ──────────────
# Pixel ID（A 站浏览器 Pixel 与 B 站 CAPI 共用同一个）
META_PIXEL_ID=
# Conversions API access token（Events Manager → 设置 → 生成访问令牌，仅服务端使用，勿加 NEXT_PUBLIC 前缀）
META_CAPI_ACCESS_TOKEN=
# A 站→B 站 /api/meta/capi 代理端点的共享密钥（自定长随机串，A 站 main.js CONFIG 同步）
META_CAPI_SHARED_KEY=
