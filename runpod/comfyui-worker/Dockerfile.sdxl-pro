# SoulMate9 ComfyUI SDXL-Pro serverless worker (multi-model matrix endpoint)
#
# Isolated from the FLUX worker image on purpose: the FLUX endpoint keeps its
# Shakker-only node stack, while this image carries the SDXL enhancement stack:
#   Impact-Pack      : FaceDetailer (yolov8 bbox detect + local repaint)
#   Impact-Subpack   : UltralyticsDetectorProvider (FaceDetailer's detector;
#                      separate repo — ComfyUI only loads top-level custom_nodes
#                      dirs, so the submodule copy inside Impact-Pack is ignored)
#   controlnet_aux   : DWPreprocessor / DepthAnythingV2 for SDXL ControlNet
#   IPAdapter_plus   : FaceID Plus V2 (identity lock, SDXL)
#   ComfyUI-Manager  : runtime node diagnostics
#
# Models come from the RunPod network volume at /runpod-volume/models
# (provisioned by the sdxl-bundle-installer endpoint). The official worker's
# extra_model_paths.yaml already maps checkpoints/loras/controlnet/
# upscale_models off the volume; ultralytics + ipadapter are linked at
# container start by start-sdxl-pro.sh (volume is only mounted at runtime).
FROM runpod/worker-comfyui:5.8.6-base

USER root

# ─── Custom nodes ───────────────────────────────────────────
# NOTE: UltralyticsDetectorProvider lives in ltdrdata/ComfyUI-Impact-Subpack.
# ComfyUI's init_external_custom_nodes() only scans the TOP LEVEL of
# custom_nodes, so it must be cloned as its own top-level directory — the
# `subpack` submodule inside Impact-Pack would never be imported.
RUN git clone --depth 1 \
      https://github.com/ltdrdata/ComfyUI-Impact-Pack.git \
      /comfyui/custom_nodes/ComfyUI-Impact-Pack \
    && git clone --depth 1 \
      https://github.com/ltdrdata/ComfyUI-Impact-Subpack.git \
      /comfyui/custom_nodes/ComfyUI-Impact-Subpack \
    && git clone --depth 1 https://github.com/Fannovel16/comfyui_controlnet_aux.git \
      /comfyui/custom_nodes/comfyui_controlnet_aux \
    && git clone --depth 1 https://github.com/cubiq/ComfyUI_IPAdapter_plus.git \
      /comfyui/custom_nodes/ComfyUI_IPAdapter_plus \
    && git clone --depth 1 https://github.com/ltdrdata/ComfyUI-Manager.git \
      /comfyui/custom_nodes/ComfyUI-Manager \
    && for node in ComfyUI-Impact-Pack ComfyUI-Impact-Subpack comfyui_controlnet_aux ComfyUI_IPAdapter_plus ComfyUI-Manager; do \
         if [ -f "/comfyui/custom_nodes/$node/requirements.txt" ]; then \
           python -m pip install --no-cache-dir \
             -r "/comfyui/custom_nodes/$node/requirements.txt"; \
         fi; \
       done \
    # InsightFace is required by IPAdapter FaceID; onnxruntime is its CPU-safe
    # backend on serverless workers.
    && python -m pip install --no-cache-dir insightface onnxruntime \
    # Hard guard: abort the build if the detector provider is absent — this
    # exact regression (node silently missing) cost a live-worker round-trip.
    && grep -q UltralyticsDetectorProvider \
      /comfyui/custom_nodes/ComfyUI-Impact-Subpack/modules/subpack_nodes.py

# PyTorch >= 2.6 loads .pt with weights_only=True first, which fails for the
# adetailer yolov8 checkpoints; subpack only retries with weights_only=False
# for files listed in its model-whitelist.txt. Pre-seed it at build time.
RUN mkdir -p /comfyui/user/default/ComfyUI-Impact-Subpack \
    && printf 'bbox/face_yolov8m.pt\n' \
      > /comfyui/user/default/ComfyUI-Impact-Subpack/model-whitelist.txt

# Build-time smoke test: starting ComfyUI imports every custom node module, so
# an import-breaking dependency fails HERE instead of on a live worker.
# The guard only skips when the ComfyUI build predates --quick-test-for-ci;
# any real failure (non-zero exit) aborts the build.
RUN cd /comfyui \
    && if python main.py --help 2>&1 | grep -q quick-test-for-ci; then \
         timeout 300 python main.py --quick-test-for-ci --cpu; \
       else \
         echo "sdxl-pro: quick-test-for-ci unavailable, skipping smoke test"; \
       fi

# ─── Runtime model links ────────────────────────────────────
# /runpod-volume is only mounted at container start, so volume symlinks must be
# created then (not at build time). start-sdxl-pro.sh wraps the official
# entrypoint and links the two model dirs the official extra_model_paths.yaml
# does not cover (ultralytics for Impact-Pack, ipadapter for IPAdapter_plus).
COPY start-sdxl-pro.sh /start-sdxl-pro.sh
RUN chmod +x /start-sdxl-pro.sh

CMD ["/start-sdxl-pro.sh"]
